
# --- Required variables ------------

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Service Account Email
# Required for generating signed URLs and accessing GCP services
SERVICE_ACCOUNT_EMAIL=service-account-name@project_ID.iam.gserviceaccount.com

# Cloud Storage Buckets
# Format: {project-id}-videos-source and {project-id}-videos-processed
SOURCE_BUCKET_NAME=your-project-id-videos-source
PROCESSED_BUCKET_NAME=your-project-id-videos-processed

# Application Configuration
PORT=8080
ENVIRONMENT=dev  # dev, staging, production



# --- Optional variables ------------

# Firestore Configuration
# If you have multiple Firestore databases, specify the database name
# Leave empty or use "(default)" for the default database
FIRESTORE_DATABASE_ID=(default)

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Upload Configuration
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv
UPLOAD_URL_EXPIRY_HOURS=1

# HLS Delivery Configuration
# Expiry for the signed URLs embedded in rendition playlists (segments)
HLS_SIGNED_URL_EXPIRY_HOURS=6
# Browser origins allowed to call the API. Comma-separated; "*" allows any.
CORS_ALLOWED_ORIGINS=*

# Pub/Sub Configuration
PUBSUB_VIDEO_UPLOADED_TOPIC=video-uploaded
PUBSUB_VIDEO_PROCESSING_COMPLETE_TOPIC=video-processing-complete
PUBSUB_PROCESSOR_SUBSCRIPTION=video-processor-sub
ENABLE_AUTO_PROCESSING=true

# Transcoder Configuration
TRANSCODER_LOCATION=us-central1
TRANSCODER_TEMPLATE_ID=hls-adaptive-template